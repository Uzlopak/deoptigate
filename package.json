{
  "name": "@clinic/deoptigate",
  "version": "1.0.0",
  "description": "Programmable interface to Clinic.js Deoptigate",
  "main": "src/index.js",
  "bin": {
    "deoptigate": "./bin/deoptigate"
  },
  "files": [
    "app/build/",
    "app/lib/",
    "bin/",
    "assets/",
    "deoptigate.js",
    "deoptigate.log.js",
    "lib/",
    "src/",
    "visualizer/"
  ],
  "scripts": {
    "test": "tape test/*.test.js",
    "bench": "node benchmark/parse-v8-log.js",
    "bench:csv-escape-field": "node benchmark/csv-escape-field.bench.js",
    "bench:csv-parse-line": "node benchmark/csv-parse-line.bench.js",
    "bench:csvparser": "npm run bench:csv-escape-field && npm run bench:csv-parse-line",
    "test:coverage": "c8 --check-coverage --statements 100 --branches 100 --functions 100 --lines 100 --include=deoptigate.js --include=deoptigate.log.js --include='app/lib/**/*.js' --include='bin/**/*.js' --include='lib/**/*.js' --include='src/**/*.js' --exclude='lib/v8-tools-core/**' --reporter=text npm test"
  },
  "repository": "https://github.com/clinicjs/node-clinic-deoptigate-profiler",
  "homepage": "https://github.com/clinicjs/node-clinic-deoptigate-profiler",
  "keywords": [
    "clinicjs",
    "v8",
    "deoptimization",
    "profiler"
  ],
  "author": {
    "name": "Thorsten Lorenz",
    "email": "thlorenz@gmx.de",
    "url": "http://thlorenz.com"
  },
  "contributors": [
    {
      "name": "Aras Abbasi",
      "email": "aras.abbasi@gmail.com"
    }
  ],
  "license": "MIT",
  "engines": {
    "node": ">=12.13.0"
  },
  "dependencies": {
    "@clinic/clinic-common": "^7.1.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "escape-string-regexp": "^4.0.0",
    "tape": "^5.0.0",
    "tinybench": "^2.9.0"
  }
}
