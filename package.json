{
  "name": "@clinic/deoptigate",
  "version": "1.0.0",
  "description": "Programmable interface to Clinic.js Deoptigate",
  "main": "src/index.js",
  "bin": {
    "deoptigate": "./bin/deoptigate"
  },
  "files": [
    "app/build/",
    "app/lib/",
    "bin/",
    "assets/",
    "deoptigate.js",
    "deoptigate.log.js",
    "lib/",
    "src/",
    "visualizer/"
  ],
  "scripts": {
    "demo": "node bin/demo.js",
    "test": "node --test test/*.test.js",
    "bench": "node benchmark/parse-v8-log.js",
    "bench:csv-escape-field": "node benchmark/csv-escape-field.bench.js",
    "bench:csv-parse-line": "node benchmark/csv-parse-line.bench.js",
    "bench:csvparser": "npm run bench:csv-escape-field && npm run bench:csv-parse-line",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=deoptigate.js --test-coverage-include=deoptigate.log.js --test-coverage-include='app/lib/**/*.js' --test-coverage-include='bin/**/*.js' --test-coverage-include='lib/**/*.js' --test-coverage-include='src/**/*.js' --test-coverage-exclude='lib/v8-tools-core/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test test/*.test.js"
  },
  "repository": "https://github.com/clinicjs/node-clinic-deoptigate",
  "homepage": "https://github.com/clinicjs/node-clinic-deoptigate",
  "keywords": [
    "clinicjs",
    "v8",
    "deoptimization",
    "profiler"
  ],
  "author": {
    "name": "Thorsten Lorenz",
    "email": "thlorenz@gmx.de",
    "url": "http://thlorenz.com"
  },
  "contributors": [
    {
      "name": "Aras Abbasi",
      "email": "aras.abbasi@gmail.com"
    }
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.8.0"
  },
  "dependencies": {
    "@clinic/clinic-common": "^8.0.0"
  },
  "devDependencies": {
    "escape-string-regexp": "^4.0.0",
    "tinybench": "^2.9.0"
  }
}
