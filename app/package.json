{
  "name": "deoptigate-app",
  "version": "0.0.0",
  "description": "Investigates v8/Node.js function deoptimizations in the browser.",
  "main": "main.js",
  "scripts": {
    "bundle": "npm run bundle-js && npm run bundle-css",
    "bundle-js": "esbuild main.js --bundle --format=iife --global-name=deoptigateRender --loader:.js=jsx --jsx-factory=Preact.createElement --target=es2015 --define:process.env.NODE_ENV='\"production\"' --alias:path=./path-stub.js --minify --outfile=build/deoptigate.js",
    "bundle-css": "node build-css.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/thlorenz/deoptigate.git"
  },
  "homepage": "https://github.com/thlorenz/deoptigate",
  "keywords": [],
  "author": {
    "name": "Thorsten Lorenz",
    "email": "thlorenz@gmx.de",
    "url": "http://thlorenz.com"
  },
  "license": {
    "type": "MIT",
    "url": "https://github.com/thlorenz/deoptigate/blob/master/LICENSE"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "cssnano": "^7.1.9",
    "esbuild": "^0.28.2",
    "peacock": "~1.0.0",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "preact": "^11.0.0",
    "scroll-into-view-if-needed": "~2.2.2",
    "tachyons": "~4.9.1"
  }
}
